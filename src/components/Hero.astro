---
const specs = [
  { label: '土地価格（想定）', value: '2,000万円程度' },
  { label: '都内からの距離', value: '電車約50分圏' },
  { label: '想定エリア', value: '八王子周辺' },
  { label: '総区画数', value: '12〜20区画' },
  { label: '1区画面積', value: '約200㎡' },
  { label: 'ステータス', value: '需要観測中' },
] as const;
---

<section class="hero" id="top">
  <div class="hero-body container">
    <p class="hero-eyebrow">
      <span class="hero-eyebrow-en">Weekend Second Home / Farm House Project</span>
    </p>

    <h1 class="hero-title">
      小さな農園付き分譲地、<br />
      あなたの週末セカンドハウス。
    </h1>

    <p class="hero-sub">都内で暮らしながら、週末だけ土に触れる。</p>

    <p class="hero-desc">
      完全移住ではなく、週末だけのもうひとつの生活。<br />
      別荘ほど重くなく、家庭菜園より少し本格的な場所。<br />
      都内から50分圏、農業指導員常駐、建築条件なし。
    </p>

    <div class="hero-actions">
      <a href="#about" class="btn btn-ghost">企画を読む</a>
      <a href="#contact" class="btn btn-ghost">興味・感想を送る</a>
    </div>
  </div>

  <div class="hero-specs">
    <div class="container hero-specs-inner">
      {specs.map((s) => (
        <div class="spec-item">
          <span class="spec-label">{s.label}</span>
          <span class="spec-value">{s.value}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--bg-dark);
    background-image:
      linear-gradient(to bottom, rgba(20,26,19,0.55), rgba(20,26,19,0.92)),
      url('/hero-bg.png');
    background-size: cover;
    background-position: center top;
    color: #fff;
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(4rem, 10vw, 7rem);
  }

  .hero-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 2rem;
    padding-bottom: 4rem;
    max-width: 760px;
  }

  .hero-eyebrow {
    margin-bottom: 2rem;
  }

  .hero-eyebrow-en {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
    font-family: var(--mono);
  }

  .hero-title {
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    color: rgba(255,255,255,0.6);
    margin-bottom: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .hero-desc {
    font-size: 0.9rem;
    line-height: 2;
    color: rgba(255,255,255,0.45);
    margin-bottom: 2.5rem;
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Specs bar at bottom */
  .hero-specs {
    border-top: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.25);
  }

  .hero-specs-inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 0;
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .spec-item:last-child { border-right: none; }
  .spec-item:not(:first-child) { padding-left: 1.5rem; }

  .spec-label {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    font-family: var(--mono);
  }

  .spec-value {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255,255,255,0.8);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .hero-specs-inner {
      grid-template-columns: repeat(3, 1fr);
    }

    .spec-item:nth-child(3) { border-right: none; }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 75vh;
    }

    .hero-specs-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .spec-item:nth-child(2n) { border-right: none; }
    .spec-item:nth-child(3) { border-right: 1px solid rgba(255,255,255,0.08); }
  }
</style>
