---
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="logo" aria-label="トップへ">
      <span class="logo-en">Weekend Farm House</span>
      <span class="logo-ja">週末セカンドハウス構想</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="メインナビゲーション">
      <a href="#about">About</a>
      <a href="#concept">Concept</a>
      <a href="#specs">Plan</a>
      <a href="#services">Support</a>
      <a href="#faq">FAQ</a>
      <a href="#contact" class="nav-contact">興味・感想を送る</a>
    </nav>

    <button
      class="nav-toggle"
      aria-label="メニューを開く"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
  const nav = document.getElementById('site-nav') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isOpen = nav.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(249, 247, 243, 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
    gap: 2rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    line-height: 1;
  }

  .logo-en {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-transform: uppercase;
  }

  .logo-ja {
    font-size: 0.62rem;
    color: var(--ink-muted);
    letter-spacing: 0.05em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav a {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-transform: uppercase;
    transition: color 0.15s;
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav-contact {
    font-size: 0.75rem !important;
    letter-spacing: 0.04em !important;
    text-transform: none !important;
    border: 1px solid var(--line) !important;
    padding: 0.4rem 0.9rem;
    color: var(--ink) !important;
    transition: border-color 0.15s, color 0.15s !important;
  }

  .nav-contact:hover {
    border-color: var(--ink) !important;
    color: var(--ink) !important;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    width: 2rem;
    height: 2rem;
  }

  .nav-toggle span {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--ink);
    transition: all 0.25s;
  }

  @media (max-width: 768px) {
    .nav-toggle { display: flex; }

    .nav {
      display: none;
      position: absolute;
      top: 3.75rem;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }

    .nav.nav-open { display: flex; }

    .nav a {
      width: 100%;
      padding: 0.85rem var(--pad-x);
      font-size: 0.85rem !important;
      text-transform: none !important;
      letter-spacing: 0.02em !important;
      border-top: 1px solid var(--line-soft);
    }

    .nav-contact {
      border: none !important;
      padding: 0.85rem var(--pad-x) !important;
    }
  }
</style>
