---
const data = [
  { label: '想定エリア', value: '八王子周辺（構想）' },
  { label: '都内からの所要時間', value: '電車で約50分以内' },
  { label: '交通手段', value: '電車アクセスを重視' },
  { label: '週のリズム', value: '平日は都内・週末は現地' },
  { label: '具体的な候補地', value: '未定（情報募集中）' },
] as const;
---

<section id="location" class="location">
  <div class="container">
    <span class="section-label">Location</span>
    <h2 class="section-title">立地イメージ</h2>

    <div class="location-layout">
      <div class="location-text">
        <p>
          都内から電車で50分以内に行ける場所を想定しています。
          たとえば、八王子周辺。
        </p>
        <p>
          週末に気軽に通える距離感を重視します。
          都市との接続を保ちながら、もうひとつの生活拠点を持つ——
          そのバランスが、この企画の核心です。
        </p>

        <dl class="location-data">
          {data.map((d) => (
            <div class="location-data-row">
              <dt>{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))}
        </dl>

        <p class="location-callout">
          候補地・地域情報をお持ちの方は、フォームからご連絡ください。
          不動産会社・デベロッパー・地域事業者の方も歓迎しています。
        </p>
      </div>

      <!-- Abstract distance visualization -->
      <div class="location-visual" aria-label="東京都心から八王子周辺までの距離感のイメージ">
        <svg viewBox="0 0 360 300" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Grid -->
          <defs>
            <pattern id="loc-grid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e0ddd8" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="360" height="300" fill="#f9f7f3"/>
          <rect width="360" height="300" fill="url(#loc-grid)"/>

          <!-- Rail line -->
          <line x1="40" y1="150" x2="320" y2="150" stroke="#c8c4be" stroke-width="2"/>
          <line x1="40" y1="150" x2="320" y2="150" stroke="white" stroke-width="1" stroke-dasharray="8,4"/>

          <!-- Stations -->
          <!-- Tokyo side -->
          <circle cx="280" cy="150" r="8" fill="#181818"/>
          <text x="280" y="138" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace" font-weight="bold">都内</text>
          <text x="280" y="127" text-anchor="middle" font-size="6.5" fill="#888" font-family="monospace">主な生活拠点</text>

          <!-- Midpoint -->
          <circle cx="190" cy="150" r="4" fill="none" stroke="#c8c4be" stroke-width="1.5"/>
          <text x="190" y="165" text-anchor="middle" font-size="6" fill="#aaa" font-family="monospace">約25分</text>

          <!-- Hachioji side -->
          <circle cx="80" cy="150" r="12" fill="white" stroke="#253d2c" stroke-width="2"/>
          <circle cx="80" cy="150" r="5" fill="#253d2c"/>
          <text x="80" y="133" text-anchor="middle" font-size="8" fill="#253d2c" font-family="monospace" font-weight="bold">八王子周辺</text>
          <text x="80" y="122" text-anchor="middle" font-size="6.5" fill="#3d5e47" font-family="monospace">候補エリア</text>

          <!-- Time label -->
          <line x1="80" y1="170" x2="280" y2="170" stroke="#aaa" stroke-width="0.8"/>
          <line x1="80" y1="167" x2="80" y2="173" stroke="#aaa" stroke-width="0.8"/>
          <line x1="280" y1="167" x2="280" y2="173" stroke="#aaa" stroke-width="0.8"/>
          <text x="180" y="183" text-anchor="middle" font-size="8" fill="#666" font-family="monospace">電車 約50分以内</text>

          <!-- Weekend rhythm diagram -->
          <rect x="40" y="220" width="280" height="56" fill="white" stroke="#e0ddd8" stroke-width="1"/>
          <text x="50" y="238" font-size="6.5" fill="#888" font-family="monospace">週のリズム</text>
          <!-- Days -->
          <rect x="50" y="244" width="28" height="22" fill="#181818"/>
          <text x="64" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">月</text>
          <rect x="82" y="244" width="28" height="22" fill="#181818"/>
          <text x="96" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">火</text>
          <rect x="114" y="244" width="28" height="22" fill="#181818"/>
          <text x="128" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">水</text>
          <rect x="146" y="244" width="28" height="22" fill="#181818"/>
          <text x="160" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">木</text>
          <rect x="178" y="244" width="28" height="22" fill="#181818"/>
          <text x="192" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">金</text>
          <rect x="210" y="244" width="28" height="22" fill="#253d2c"/>
          <text x="224" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">土</text>
          <rect x="242" y="244" width="28" height="22" fill="#253d2c"/>
          <text x="256" y="259" text-anchor="middle" font-size="7" fill="white" font-family="monospace">日</text>

          <rect x="50" y="266" width="132" height="4" rx="1" fill="#e0ddd8"/>
          <text x="116" y="276" text-anchor="middle" font-size="5.5" fill="#888" font-family="monospace">都内（平日）</text>
          <rect x="210" y="266" width="60" height="4" rx="1" fill="#253d2c"/>
          <text x="240" y="276" text-anchor="middle" font-size="5.5" fill="#3d5e47" font-family="monospace">現地（週末）</text>

          <!-- North hint -->
          <line x1="336" y1="20" x2="336" y2="10" stroke="#aaa" stroke-width="1"/>
          <polygon points="336,10 333,17 339,17" fill="#aaa"/>
          <text x="336" y="28" text-anchor="middle" font-size="6" fill="#aaa" font-family="monospace">N</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--bg-white);
    border-bottom: 1px solid var(--line);
  }

  .location-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .location-text {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--ink-soft);
  }

  .location-text p + p {
    margin-top: 0.9rem;
  }

  .location-data {
    display: flex;
    flex-direction: column;
    margin: 2rem 0 1.5rem;
  }

  .location-data-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    font-family: var(--mono);
    padding-top: 0.1rem;
  }

  dd {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .location-callout {
    font-size: 0.82rem;
    color: var(--ink-muted);
    line-height: 1.7;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--green);
    background: var(--green-light);
  }

  .location-visual {
    border: 1px solid var(--line);
  }

  .location-visual svg {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .location-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .location-data-row {
      grid-template-columns: 110px 1fr;
    }
  }
</style>
