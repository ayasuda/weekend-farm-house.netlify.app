---
---

<section id="specs" class="specs">
  <div class="container">
    <p class="section-label">Specs</p>
    <h2 class="section-title">区画・建物イメージ</h2>

    <div class="specs-grid">
      <!-- Plot specs -->
      <div class="specs-block">
        <h3 class="specs-block-title">区画スペック（構想）</h3>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>総区画数</dt>
            <dd>12〜20区画（想定）</dd>
          </div>
          <div class="spec-row">
            <dt>1区画の広さ</dt>
            <dd>約200㎡</dd>
          </div>
          <div class="spec-row">
            <dt>建築条件</dt>
            <dd>なし（購入者が自由に設計・建築可能）</dd>
          </div>
          <div class="spec-row">
            <dt>家庭菜園</dt>
            <dd>各区画に隣接したスタイルで提供予定</dd>
          </div>
          <div class="spec-row">
            <dt>駐車スペース</dt>
            <dd>共同管理棟に共用駐車場を設置予定</dd>
          </div>
          <div class="spec-row">
            <dt>共用設備</dt>
            <dd>小公園、共同管理棟</dd>
          </div>
        </dl>
      </div>

      <!-- Building plan example -->
      <div class="specs-block">
        <h3 class="specs-block-title">建築プラン例（平屋モデル）</h3>
        <p class="specs-note">
          ※ 建築条件なしのため、以下はあくまで参考例です。
          ご自身の設計で自由に建てていただける想定です。
        </p>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>延床面積</dt>
            <dd>約80〜100㎡（平屋）</dd>
          </div>
          <div class="spec-row">
            <dt>間取り</dt>
            <dd>LDK + 主寝室 + 子ども部屋/多目的室 + 収納</dd>
          </div>
          <div class="spec-row">
            <dt>ウッドデッキ</dt>
            <dd>LDKに接続、家族がくつろげる屋外スペース</dd>
          </div>
          <div class="spec-row">
            <dt>バーベキュースペース</dt>
            <dd>庭の一角に設置（共用BBQ場は設けない）</dd>
          </div>
          <div class="spec-row">
            <dt>裏庭型家庭菜園</dt>
            <dd>隣接する菜園区画で農業体験が可能</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Floor plan illustration -->
    <div class="floor-plan">
      <h3 class="floor-plan-title">平屋モデル・間取りイメージ</h3>
      <div class="floor-plan-visual">
        <svg viewBox="0 0 560 360" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="平屋間取りのイメージ図">
          <!-- Outer wall -->
          <rect x="20" y="20" width="520" height="310" rx="4" fill="#f5ede0" stroke="#8b7355" stroke-width="3"/>

          <!-- LDK -->
          <rect x="20" y="20" width="230" height="200" fill="#e8f5e4" stroke="#8b7355" stroke-width="1.5"/>
          <text x="135" y="120" text-anchor="middle" font-size="14" fill="#4a6741" font-family="sans-serif" font-weight="bold">LDK</text>
          <text x="135" y="140" text-anchor="middle" font-size="11" fill="#6b6b6b" font-family="sans-serif">約20〜24畳</text>

          <!-- Master bedroom -->
          <rect x="250" y="20" width="170" height="130" fill="#fdf0e0" stroke="#8b7355" stroke-width="1.5"/>
          <text x="335" y="80" text-anchor="middle" font-size="12" fill="#8b6e4e" font-family="sans-serif" font-weight="bold">主寝室</text>
          <text x="335" y="98" text-anchor="middle" font-size="10" fill="#6b6b6b" font-family="sans-serif">約8〜10畳</text>

          <!-- Kids room -->
          <rect x="420" y="20" width="120" height="130" fill="#e0f0fa" stroke="#8b7355" stroke-width="1.5"/>
          <text x="480" y="80" text-anchor="middle" font-size="11" fill="#4a6479" font-family="sans-serif" font-weight="bold">子ども部屋</text>
          <text x="480" y="98" text-anchor="middle" font-size="10" fill="#6b6b6b" font-family="sans-serif">約6〜8畳</text>

          <!-- Storage -->
          <rect x="250" y="150" width="290" height="70" fill="#f0ebe3" stroke="#8b7355" stroke-width="1.5"/>
          <text x="395" y="190" text-anchor="middle" font-size="12" fill="#6b5f52" font-family="sans-serif" font-weight="bold">収納・廊下</text>

          <!-- Bathroom/utility -->
          <rect x="250" y="220" width="140" height="110" fill="#e8e0f5" stroke="#8b7355" stroke-width="1.5"/>
          <text x="320" y="272" text-anchor="middle" font-size="11" fill="#6b5a7a" font-family="sans-serif" font-weight="bold">水まわり</text>
          <text x="320" y="290" text-anchor="middle" font-size="10" fill="#6b6b6b" font-family="sans-serif">浴室・洗面・トイレ</text>

          <!-- Deck -->
          <rect x="20" y="220" width="230" height="110" fill="#d4e8c0" stroke="#6a8a50" stroke-width="1.5" stroke-dasharray="6,3"/>
          <text x="135" y="270" text-anchor="middle" font-size="13" fill="#4a6741" font-family="sans-serif" font-weight="bold">ウッドデッキ</text>
          <text x="135" y="290" text-anchor="middle" font-size="10" fill="#6b6b6b" font-family="sans-serif">BBQスペース含む</text>

          <!-- Garden label -->
          <rect x="390" y="220" width="150" height="110" fill="#c8dca0" stroke="#6a8a50" stroke-width="1.5" stroke-dasharray="6,3"/>
          <text x="465" y="268" text-anchor="middle" font-size="12" fill="#354d2f" font-family="sans-serif" font-weight="bold">庭・菜園</text>
          <text x="465" y="286" text-anchor="middle" font-size="10" fill="#6b6b6b" font-family="sans-serif">農業体験エリア</text>

          <!-- Compass -->
          <text x="540" y="348" text-anchor="middle" font-size="10" fill="#aaa" font-family="sans-serif">N↑</text>
        </svg>
      </div>
      <p class="floor-plan-note">
        ※ この間取り図はイメージです。実際の設計は購入者の自由です。建築条件はありません。
      </p>
    </div>
  </div>
</section>

<style>
  .specs {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .specs-block-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-accent);
  }

  .specs-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    line-height: 1.7;
    background: var(--color-notice);
    padding: 0.6rem 0.75rem;
    border-radius: 0.375rem;
  }

  .spec-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .spec-row:last-child {
    border-bottom: none;
  }

  dt {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    padding-top: 0.1rem;
  }

  dd {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.7;
  }

  .floor-plan {
    margin-top: 1rem;
  }

  .floor-plan-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
  }

  .floor-plan-visual {
    background: var(--color-notice);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .floor-plan-visual svg {
    width: 100%;
    height: auto;
    max-height: 400px;
  }

  .floor-plan-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 700px) {
    .specs-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .spec-row {
      grid-template-columns: 100px 1fr;
    }
  }
</style>
