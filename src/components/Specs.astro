---
---

<section id="specs" class="specs">
  <div class="container">
    <span class="section-label">Site Plan & Floor Plan</span>
    <h2 class="section-title">区画・建物イメージ</h2>

    <div class="specs-cols">
      <!-- Plot specs table -->
      <div>
        <p class="specs-block-label">区画スペック（構想）</p>
        <dl class="spec-table">
          <div class="spec-row">
            <dt>総区画数</dt>
            <dd>12〜20区画（想定）</dd>
          </div>
          <div class="spec-row">
            <dt>1区画面積</dt>
            <dd>約200㎡</dd>
          </div>
          <div class="spec-row">
            <dt>建築条件</dt>
            <dd>なし — 購入者が自由に設計・建築可能</dd>
          </div>
          <div class="spec-row">
            <dt>家庭菜園</dt>
            <dd>各区画に隣接した裏庭スタイルで提供予定</dd>
          </div>
          <div class="spec-row">
            <dt>駐車スペース</dt>
            <dd>共同管理棟に共用駐車場を設置予定</dd>
          </div>
          <div class="spec-row">
            <dt>共用設備</dt>
            <dd>小公園、共同管理棟</dd>
          </div>
        </dl>
      </div>

      <!-- Building spec table -->
      <div>
        <p class="specs-block-label">建築プラン例（参考・平屋モデル）</p>
        <p class="specs-note">建築条件なし。以下はあくまで参考プランです。</p>
        <dl class="spec-table">
          <div class="spec-row">
            <dt>延床面積</dt>
            <dd>約80〜100㎡（平屋）</dd>
          </div>
          <div class="spec-row">
            <dt>間取り</dt>
            <dd>LDK / 主寝室 / 子ども部屋・多目的室 / 収納</dd>
          </div>
          <div class="spec-row">
            <dt>ウッドデッキ</dt>
            <dd>LDKに接続する屋外スペース</dd>
          </div>
          <div class="spec-row">
            <dt>BBQスペース</dt>
            <dd>庭の一角（共用BBQ場は設けない）</dd>
          </div>
          <div class="spec-row">
            <dt>裏庭型菜園</dt>
            <dd>隣接する菜園区画で農業体験が可能</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Reference photo -->
    <div class="specs-photo">
      <p class="specs-photo-label">Exterior Reference — 外観イメージ（参考）</p>
      <div class="specs-photo-frame">
        <img
          src="/house-exterior.png"
          alt="平屋外観の参考イメージ"
          class="specs-photo-img"
        />
      </div>
      <p class="drawing-note">※ 参考イメージです。建築条件はなく、実際の外観は購入者が自由に設計できます。</p>
    </div>

    <!-- Site plan (blueprint style) -->
    <div class="drawings-row">
      <div class="drawing-block">
        <p class="drawing-label">配置計画図（コンセプト）</p>
        <div class="drawing-frame">
          <svg viewBox="0 0 440 340" fill="none" xmlns="http://www.w3.org/2000/svg"
               role="img" aria-label="区画配置図のコンセプト">
            <!-- Grid background -->
            <rect width="440" height="340" fill="#f9f7f3"/>
            <defs>
              <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e0ddd8" stroke-width="0.5"/>
              </pattern>
            </defs>
            <rect width="440" height="340" fill="url(#grid)"/>

            <!-- Road (horizontal) -->
            <rect x="0" y="148" width="440" height="28" fill="#e8e5e0"/>
            <line x1="0" y1="162" x2="440" y2="162" stroke="#c8c4be" stroke-width="1" stroke-dasharray="12,6"/>
            <text x="6" y="159" font-size="6" fill="#aaa" font-family="monospace" letter-spacing="1">ROAD</text>

            <!-- Road (vertical) -->
            <rect x="192" y="0" width="24" height="148" fill="#e8e5e0"/>
            <rect x="192" y="176" width="24" height="164" fill="#e8e5e0"/>
            <line x1="204" y1="0" x2="204" y2="148" stroke="#c8c4be" stroke-width="1" stroke-dasharray="12,6"/>
            <line x1="204" y1="176" x2="204" y2="340" stroke="#c8c4be" stroke-width="1" stroke-dasharray="12,6"/>

            <!-- Plots (top row, left side) -->
            <rect x="10" y="10" width="78" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="49" y="62" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.01</text>
            <text x="49" y="73" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <!-- Garden strip -->
            <rect x="10" y="118" width="78" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="49" y="132" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <rect x="96" y="10" width="88" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="140" y="62" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.02</text>
            <text x="140" y="73" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="96" y="118" width="88" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="140" y="132" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <!-- Plots (top row, right side) -->
            <rect x="224" y="10" width="96" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="272" y="62" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.03</text>
            <text x="272" y="73" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="224" y="118" width="96" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="272" y="132" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <rect x="328" y="10" width="102" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="379" y="62" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.04</text>
            <text x="379" y="73" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="328" y="118" width="102" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="379" y="132" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <!-- Plots (bottom row, left side) -->
            <rect x="10" y="176" width="78" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="49" y="228" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.05</text>
            <text x="49" y="239" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="10" y="284" width="78" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="49" y="298" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <rect x="96" y="176" width="88" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="140" y="228" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.06</text>
            <text x="140" y="239" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="96" y="284" width="88" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="140" y="298" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <!-- Bottom row, right side -->
            <rect x="224" y="176" width="96" height="130" fill="white" stroke="#4a4a4a" stroke-width="1.2"/>
            <text x="272" y="228" text-anchor="middle" font-size="7" fill="#666" font-family="monospace">No.07</text>
            <text x="272" y="239" text-anchor="middle" font-size="6" fill="#999" font-family="monospace">200㎡</text>
            <rect x="224" y="284" width="96" height="22" fill="#e8ede9" stroke="#4a4a4a" stroke-width="0.5"/>
            <text x="272" y="298" text-anchor="middle" font-size="6" fill="#3d5e47" font-family="monospace">菜園</text>

            <!-- Management building -->
            <rect x="328" y="176" width="102" height="130" fill="#f2ede5" stroke="#7c5c38" stroke-width="1.5"/>
            <text x="379" y="232" text-anchor="middle" font-size="7" fill="#7c5c38" font-family="monospace">管理棟</text>
            <text x="379" y="244" text-anchor="middle" font-size="6" fill="#7c5c38" font-family="monospace">駐車場含む</text>

            <!-- North arrow -->
            <line x1="416" y1="22" x2="416" y2="10" stroke="#666" stroke-width="1.2"/>
            <polygon points="416,10 413,18 419,18" fill="#666"/>
            <text x="416" y="30" text-anchor="middle" font-size="6" fill="#666" font-family="monospace">N</text>

            <!-- Scale bar -->
            <line x1="10" y1="334" x2="60" y2="334" stroke="#888" stroke-width="1"/>
            <line x1="10" y1="330" x2="10" y2="338" stroke="#888" stroke-width="1"/>
            <line x1="60" y1="330" x2="60" y2="338" stroke="#888" stroke-width="1"/>
            <text x="35" y="332" text-anchor="middle" font-size="5.5" fill="#888" font-family="monospace">0 — 20m（概念）</text>

            <!-- Legend -->
            <rect x="280" y="310" width="10" height="8" fill="white" stroke="#4a4a4a" stroke-width="0.8"/>
            <text x="294" y="318" font-size="5.5" fill="#888" font-family="monospace">住宅区画</text>
            <rect x="340" y="310" width="10" height="8" fill="#e8ede9" stroke="#3d5e47" stroke-width="0.5"/>
            <text x="354" y="318" font-size="5.5" fill="#888" font-family="monospace">菜園エリア</text>
          </svg>
        </div>
        <p class="drawing-note">※ 概念図です。実際の区画割り・道路配置は未定です。</p>
      </div>

      <!-- Floor plan (blueprint style) -->
      <div class="drawing-block">
        <p class="drawing-label">参考平面図（4人家族向け平屋モデル）</p>
        <div class="drawing-frame">
          <svg viewBox="0 0 440 340" fill="none" xmlns="http://www.w3.org/2000/svg"
               role="img" aria-label="平屋モデルの参考平面図">
            <rect width="440" height="340" fill="#f9f7f3"/>
            <defs>
              <pattern id="grid2" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#e0ddd8" stroke-width="0.5"/>
              </pattern>
            </defs>
            <rect width="440" height="340" fill="url(#grid2)"/>

            <!-- Outer wall (thick) -->
            <rect x="30" y="30" width="260" height="220" fill="white" stroke="#181818" stroke-width="5"/>

            <!-- Interior walls -->
            <!-- LDK (left big area) -->
            <line x1="170" y1="30" x2="170" y2="170" stroke="#181818" stroke-width="2.5"/>
            <!-- Horizontal divide -->
            <line x1="30" y1="170" x2="290" y2="170" stroke="#181818" stroke-width="2.5"/>
            <!-- Top right divide -->
            <line x1="220" y1="30" x2="220" y2="170" stroke="#181818" stroke-width="2.5"/>

            <!-- Room labels -->
            <text x="100" y="96" text-anchor="middle" font-size="9" fill="#181818" font-family="monospace" font-weight="bold">LDK</text>
            <text x="100" y="110" text-anchor="middle" font-size="6.5" fill="#888" font-family="monospace">約22畳</text>

            <text x="195" y="85" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace">主寝室</text>
            <text x="195" y="97" text-anchor="middle" font-size="6.5" fill="#888" font-family="monospace">8〜10畳</text>

            <text x="255" y="85" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace">子ども</text>
            <text x="255" y="97" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace">部屋</text>
            <text x="255" y="110" text-anchor="middle" font-size="6.5" fill="#888" font-family="monospace">6〜8畳</text>

            <!-- Bathroom / utility (bottom right) -->
            <line x1="200" y1="170" x2="200" y2="250" stroke="#181818" stroke-width="2.5"/>
            <text x="100" y="207" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace">廊下・収納</text>
            <text x="245" y="207" text-anchor="middle" font-size="8" fill="#181818" font-family="monospace">水まわり</text>
            <text x="245" y="220" text-anchor="middle" font-size="6.5" fill="#888" font-family="monospace">浴室・洗面</text>

            <!-- Door marks (arcs) -->
            <path d="M 170 200 Q 170 170 200 170" stroke="#181818" stroke-width="0.8" fill="none" stroke-dasharray="3,2"/>
            <path d="M 245 30 Q 245 50 220 50" stroke="#181818" stroke-width="0.8" fill="none" stroke-dasharray="3,2"/>

            <!-- Deck (dashed, outside) -->
            <rect x="30" y="250" width="260" height="60" fill="#f0ede8" stroke="#4a4a4a" stroke-width="1" stroke-dasharray="6,3"/>
            <text x="160" y="284" text-anchor="middle" font-size="9" fill="#4a4a4a" font-family="monospace">ウッドデッキ / BBQスペース</text>

            <!-- Garden / farm (right side, dashed) -->
            <rect x="300" y="30" width="120" height="280" fill="#e8ede9" stroke="#3d5e47" stroke-width="1" stroke-dasharray="6,3"/>
            <!-- Garden rows -->
            <line x1="310" y1="80" x2="410" y2="80" stroke="#3d5e47" stroke-width="0.8"/>
            <line x1="310" y1="110" x2="410" y2="110" stroke="#3d5e47" stroke-width="0.8"/>
            <line x1="310" y1="140" x2="410" y2="140" stroke="#3d5e47" stroke-width="0.8"/>
            <line x1="310" y1="170" x2="410" y2="170" stroke="#3d5e47" stroke-width="0.8"/>
            <line x1="310" y1="200" x2="410" y2="200" stroke="#3d5e47" stroke-width="0.8"/>
            <line x1="310" y1="230" x2="410" y2="230" stroke="#3d5e47" stroke-width="0.8"/>
            <text x="360" y="60" text-anchor="middle" font-size="8" fill="#3d5e47" font-family="monospace">裏庭型</text>
            <text x="360" y="72" text-anchor="middle" font-size="8" fill="#3d5e47" font-family="monospace">家庭菜園</text>

            <!-- North arrow -->
            <line x1="420" y1="22" x2="420" y2="10" stroke="#666" stroke-width="1.2"/>
            <polygon points="420,10 417,18 423,18" fill="#666"/>
            <text x="420" y="30" text-anchor="middle" font-size="6" fill="#666" font-family="monospace">N</text>

            <!-- Scale -->
            <line x1="30" y1="326" x2="80" y2="326" stroke="#888" stroke-width="1"/>
            <line x1="30" y1="322" x2="30" y2="330" stroke="#888" stroke-width="1"/>
            <line x1="80" y1="322" x2="80" y2="330" stroke="#888" stroke-width="1"/>
            <text x="55" y="324" text-anchor="middle" font-size="5.5" fill="#888" font-family="monospace">0 — 5m（概念）</text>
          </svg>
        </div>
        <p class="drawing-note">※ 参考プランです。建築条件なし。実際の設計は購入者の自由です。</p>
      </div>
    </div>
  </div>
</section>

<style>
  .specs {
    background: var(--bg-white);
    border-bottom: 1px solid var(--line);
  }

  .specs-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .specs-block-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .specs-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border-left: 2px solid var(--line);
  }

  .spec-table {
    display: flex;
    flex-direction: column;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .spec-row:last-child { border-bottom: none; }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    font-family: var(--mono);
    padding-top: 0.1rem;
  }

  dd {
    font-size: 0.875rem;
    color: var(--ink);
    line-height: 1.65;
  }

  /* Exterior photo */
  .specs-photo {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .specs-photo-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
  }

  .specs-photo-frame {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .specs-photo-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 600px) {
    .specs-photo-img { height: 240px; }
  }

  /* Drawings */
  .drawings-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .drawing-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawing-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
  }

  .drawing-frame {
    border: 1px solid var(--line);
    background: #f9f7f3;
  }

  .drawing-frame svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .drawing-note {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .specs-cols, .drawings-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .spec-row { grid-template-columns: 90px 1fr; }
  }
</style>
