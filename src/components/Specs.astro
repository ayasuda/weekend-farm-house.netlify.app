---
---

<section id="specs" class="specs">
  <div class="container">
    <span class="section-label">Site Plan & Floor Plan</span>
    <h2 class="section-title">区画・建物イメージ</h2>

    <div class="specs-cols">
      <!-- Plot specs table -->
      <div>
        <p class="specs-block-label">区画スペック（構想）</p>
        <dl class="spec-table">
          <div class="spec-row">
            <dt>総区画数</dt>
            <dd>12〜20区画（想定）</dd>
          </div>
          <div class="spec-row">
            <dt>1区画面積</dt>
            <dd>約200㎡</dd>
          </div>
          <div class="spec-row">
            <dt>建築条件</dt>
            <dd>なし — 購入者が自由に設計・建築可能</dd>
          </div>
          <div class="spec-row">
            <dt>家庭菜園</dt>
            <dd>各区画に隣接した裏庭スタイルで提供予定</dd>
          </div>
          <div class="spec-row">
            <dt>駐車スペース</dt>
            <dd>共同管理棟に共用駐車場を設置予定</dd>
          </div>
          <div class="spec-row">
            <dt>共用設備</dt>
            <dd>小公園、共同管理棟</dd>
          </div>
        </dl>
      </div>

      <!-- Building spec table -->
      <div>
        <p class="specs-block-label">建築プラン例（参考・平屋モデル）</p>
        <p class="specs-note">建築条件なし。以下はあくまで参考プランです。</p>
        <dl class="spec-table">
          <div class="spec-row">
            <dt>延床面積</dt>
            <dd>約80〜100㎡（平屋）</dd>
          </div>
          <div class="spec-row">
            <dt>間取り</dt>
            <dd>LDK / 主寝室 / 子ども部屋・多目的室 / 収納</dd>
          </div>
          <div class="spec-row">
            <dt>ウッドデッキ</dt>
            <dd>LDKに接続する屋外スペース</dd>
          </div>
          <div class="spec-row">
            <dt>BBQスペース</dt>
            <dd>庭の一角（共用BBQ場は設けない）</dd>
          </div>
          <div class="spec-row">
            <dt>裏庭型菜園</dt>
            <dd>隣接する菜園区画で農業体験が可能</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Reference photo -->
    <div class="specs-photo">
      <p class="specs-photo-label">Exterior Reference — 外観イメージ（参考）</p>
      <div class="specs-photo-frame">
        <img
          src="/house-exterior.png"
          alt="平屋外観の参考イメージ"
          class="specs-photo-img"
        />
      </div>
      <p class="drawing-note">※ 参考イメージです。建築条件はなく、実際の外観は購入者が自由に設計できます。</p>
    </div>

    <!-- Site plan & floor plan -->
    <div class="drawings-row">
      <div class="drawing-block">
        <p class="drawing-label">配置計画図（コンセプト）</p>
        <div class="drawing-frame">
          <img
            src="/site-plan.png"
            alt="区画配置図のコンセプト"
            class="drawing-img"
          />
        </div>
        <p class="drawing-note">※ 概念図です。実際の区画割り・道路配置は未定です。</p>
      </div>

      <div class="drawing-block">
        <p class="drawing-label">参考平面図（4人家族向け平屋モデル）</p>
        <div class="drawing-frame">
          <img
            src="/floor-plan.png"
            alt="平屋モデルの参考平面図"
            class="drawing-img"
          />
        </div>
        <p class="drawing-note">※ 参考プランです。建築条件なし。実際の設計は購入者の自由です。</p>
      </div>
    </div>
  </div>
</section>

<style>
  .specs {
    background: var(--bg-white);
    border-bottom: 1px solid var(--line);
  }

  .specs-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .specs-block-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .specs-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg);
    border-left: 2px solid var(--line);
  }

  .spec-table {
    display: flex;
    flex-direction: column;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .spec-row:last-child { border-bottom: none; }

  dt {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-muted);
    font-family: var(--mono);
    padding-top: 0.1rem;
  }

  dd {
    font-size: 0.875rem;
    color: var(--ink);
    line-height: 1.65;
  }

  /* Exterior photo */
  .specs-photo {
    margin-bottom: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .specs-photo-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
  }

  .specs-photo-frame {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .specs-photo-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  @media (max-width: 600px) {
    .specs-photo-img { height: 240px; }
  }

  /* Drawings */
  .drawings-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .drawing-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawing-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--mono);
  }

  .drawing-frame {
    border: 1px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }

  .drawing-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .drawing-note {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .specs-cols, .drawings-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .spec-row { grid-template-columns: 90px 1fr; }
  }
</style>
