---
const faqs = [
  {
    q: '実際に販売されていますか？',
    a: 'いいえ。本サイトは構想段階のコンセプトサイトです。実在する分譲地の販売広告ではありません。',
  },
  {
    q: '土地は購入できますか？',
    a: '現時点では購入できません。購入申込の受付は行っておらず、金銭のやりとりも一切ありません。',
  },
  {
    q: '価格は確定ですか？',
    a: 'いいえ。土地のみ2,000万円程度というのは構想段階の仮説です。実際の価格はエリア・面積・開発コスト等により大きく変動します。',
  },
  {
    q: '法規制や建築可否は確認済みですか？',
    a: 'いいえ。農地法・建築基準法・用途地域など、関連法規の確認は未実施です。今後検討が必要な項目です。',
  },
  {
    q: 'なぜこのサイトを作ったのですか？',
    a: '都市生活者向けの週末型セカンドハウスという暮らし方に、どれくらい共感があるかを可視化するためです。また、この企画を実現できる不動産会社・デベロッパー・地域事業者・自治体関係者への、ゆるい企画提案でもあります。',
  },
  {
    q: '農業経験がなくても大丈夫ですか？',
    a: '農業経験がない方を主な対象としています。農業指導員が常駐し、作付け相談や初心者向け講習を提供する構想です。平日に来られない方向けの菜園管理代行サービスも検討しています。',
  },
  {
    q: '建物の建築も一緒に依頼できますか？',
    a: '建築条件なしの土地分譲を構想しています。建築プランは参考例として提示しますが、購入者が自由に設計・建築できる想定です。',
  },
  {
    q: '事業として一緒に取り組みたい場合はどうすればよいですか？',
    a: 'フォームよりご連絡ください。不動産会社・デベロッパー・地域事業者・自治体関係者の方のご連絡を歓迎しています。',
  },
  {
    q: '候補地・地域情報を持っています。どうすればよいですか？',
    a: 'フォームより「土地・地域の候補がある」を選択してご連絡ください。具体的な候補地は未定であり、情報を積極的に求めています。',
  },
] as const;
---

<section id="faq" class="faq">
  <div class="container">
    <span class="section-label">FAQ</span>
    <h2 class="section-title">よくある質問</h2>

    <div class="faq-list">
      {faqs.map((item, i) => (
        <details class="faq-item" name="faq-group">
          <summary class="faq-q">
            <span class="faq-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="faq-q-text">{item.q}</span>
            <span class="faq-arrow" aria-hidden="true">+</span>
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .faq-list {
    border: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line-soft);
    background: var(--bg-white);
  }

  .faq-item:last-child { border-bottom: none; }

  .faq-q {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.5rem;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    transition: background 0.15s;
    user-select: none;
  }

  .faq-q:hover {
    background: var(--bg);
  }

  .faq-item[open] .faq-q {
    background: var(--bg);
  }

  .faq-q::-webkit-details-marker { display: none; }

  .faq-index {
    font-size: 0.65rem;
    font-family: var(--mono);
    color: var(--ink-faint);
    letter-spacing: 0.05em;
  }

  .faq-q-text {
    line-height: 1.5;
  }

  .faq-arrow {
    font-size: 1.2rem;
    color: var(--ink-faint);
    transition: transform 0.2s;
    text-align: right;
    font-weight: 300;
    line-height: 1;
  }

  .faq-item[open] .faq-arrow {
    transform: rotate(45deg);
  }

  .faq-a {
    padding: 0 1.5rem 1.5rem calc(2.5rem + 1rem + 1.5rem);
  }

  .faq-a p {
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.85;
  }

  @media (max-width: 550px) {
    .faq-q {
      grid-template-columns: 2rem 1fr 1.25rem;
      gap: 0.75rem;
      padding: 1rem;
    }

    .faq-a {
      padding: 0 1rem 1rem 1rem;
    }
  }
</style>
