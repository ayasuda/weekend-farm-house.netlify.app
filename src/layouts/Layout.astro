---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = '小さな農園付き分譲地、あなたの週末セカンドハウス',
  description = '都内で暮らしながら、週末だけ土に触れる。都市生活者のための週末型セカンドハウス構想サイトです。',
  ogImage = '/og-image-photo.png',
} = Astro.props;

const siteUrl = 'https://weekend-farm-house.netlify.app';
const fullOgImage = `${siteUrl}${ogImage}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="Weekend Farm House" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <style>
      :root {
        /* Colors */
        --ink:         #181818;
        --ink-soft:    #3a3a3a;
        --ink-muted:   #7a7a7a;
        --ink-faint:   #adadad;
        --bg:          #f9f7f3;
        --bg-white:    #ffffff;
        --bg-dark:     #141a13;
        --green:       #253d2c;
        --green-mid:   #3d5e47;
        --green-light: #e8ede9;
        --earth:       #7c5c38;
        --earth-light: #f2ede5;
        --line:        #d8d4cc;
        --line-soft:   #eceae4;

        /* Typography */
        --sans: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Noto Sans JP',
          'Yu Gothic', 'Meiryo', sans-serif;
        --serif: 'Hiragino Mincho ProN', 'Hiragino Mincho Pro', 'Yu Mincho',
          'Noto Serif JP', Georgia, serif;
        --mono: 'SF Mono', 'Fira Code', 'Consolas', monospace;

        /* Layout */
        --max-w: 1080px;
        --max-w-text: 680px;
        --pad-x: clamp(1.25rem, 5vw, 3rem);
        --section-y: clamp(4rem, 9vw, 7rem);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html { scroll-behavior: smooth; }

      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--ink);
        line-height: 1.75;
        font-size: 1rem;
        -webkit-font-smoothing: antialiased;
      }

      img { max-width: 100%; height: auto; display: block; }

      a { color: inherit; text-decoration: none; }

      /* ── Layout helpers ── */
      .wrap {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 var(--pad-x);
      }

      /* legacy alias used by some components */
      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 var(--pad-x);
      }

      section { padding: var(--section-y) 0; }

      /* ── Section headings ── */
      .section-label {
        display: block;
        font-size: 0.68rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink-muted);
        font-family: var(--mono);
        margin-bottom: 1rem;
      }

      .section-title {
        font-family: var(--sans);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin-bottom: 2rem;
      }

      .section-body {
        font-size: 0.95rem;
        line-height: 1.95;
        color: var(--ink-soft);
        max-width: var(--max-w-text);
      }

      .section-body p + p { margin-top: 1.1rem; }

      /* ── Buttons ── */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.7rem 1.6rem;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        border: 1px solid currentColor;
        cursor: pointer;
        transition: background 0.18s, color 0.18s;
        text-decoration: none;
        white-space: nowrap;
      }

      .btn-primary {
        background: var(--green);
        color: #fff;
        border-color: var(--green);
      }
      .btn-primary:hover {
        background: var(--green-mid);
        border-color: var(--green-mid);
      }

      .btn-outline {
        background: transparent;
        color: var(--ink);
        border-color: var(--line);
      }
      .btn-outline:hover {
        border-color: var(--ink);
      }

      .btn-ghost {
        background: transparent;
        color: var(--bg-white);
        border-color: rgba(255,255,255,0.4);
      }
      .btn-ghost:hover {
        background: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.7);
      }

      /* ── Divider ── */
      hr {
        border: none;
        border-top: 1px solid var(--line);
        margin: 0;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
